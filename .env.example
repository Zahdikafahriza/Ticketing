# Koneksi database (format: mysql://user:password@host:port/nama_database)
DATABASE_URL="mysql://root:@127.0.0.1:3306/tiket_pelanggan"

# NextAuth - URL aplikasi & secret untuk enkripsi session
# Generate secret dengan: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Catatan: kredensial n8n Webhook & Telegram Bot TIDAK diisi di sini lagi.
# Sekarang diatur lewat halaman /settings di web aplikasi (disimpan di database),
# supaya bisa diganti kapan saja tanpa edit file atau restart aplikasi.
